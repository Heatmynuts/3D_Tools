{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": ["build123d"],
  "extraKnownMarketplaces": {
    "text-to-cad": {
      "source": {
        "source": "github",
        "repo": "earthtojake/text-to-cad"
      }
    }
  },
  "enabledPlugins": {
    "cad@text-to-cad": true
  }
}
