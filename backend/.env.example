# Copier ce fichier en backend/.env puis renseigner la clé.
ANTHROPIC_API_KEY=
# Modèle de l'agent ingénieur (défaut : claude-opus-5-5)
ANTHROPIC_MODEL=claude-opus-5-5
# Profondeur de réflexion : low | medium | high | xhigh | max
AGENT_EFFORT=medium
# Fournisseur : anthropic | openai_compat | mock (vide = anthropic si clé présente, sinon mock)
LLM_PROVIDER=
# Pour Ollama / LM Studio (LLM_PROVIDER=openai_compat)
OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
OPENAI_COMPAT_MODEL=gemma4:12b

# ---- Comparaison A/B (modèle B via OpenRouter, choisi dans l'interface) ----
# Clé : https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Modèle B proposé par défaut (identifiant OpenRouter)
OPENROUTER_DEFAULT_MODEL=x-ai/grok-4.7
# Solde OpenRouter du compte (optionnel) : nécessite une clé de gestion (management key)
OPENROUTER_MANAGEMENT_KEY=

# ---- Solde Anthropic estimé (l'API n'expose pas le solde) ----
# Solde lu dans la console Anthropic, et la date/heure UTC de cette lecture (ISO) :
ANTHROPIC_CREDIT_BALANCE=
ANTHROPIC_CREDIT_DATE=

# ---- CAO et slicing local ----
# Par défaut : tools/BambuStudio.app si présent, sinon /Applications/BambuStudio.app.
# BAMBU_STUDIO_BIN=/chemin/BambuStudio.app/Contents/MacOS/BambuStudio
# BAMBU_PROFILES_DIR=/chemin/BambuStudio.app/Contents/Resources/profiles/BBL
